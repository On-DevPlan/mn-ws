{
  "name": "mn-ws-monorepo",
  "private": true,
  "type": "module",
  "description": "mn-ws —— HTTP ⇄ WebSocket 双向桥（Rust 运行时；npm 壳与 React 面板在 client/）",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "dev": "pnpm --filter mn-ws dev"
  },
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/On-DevPlan/mn-ws.git"
  }
}
